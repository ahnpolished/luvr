# ============================================================
# Luvr - iMessage Dating Advice Chatbot Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Server ---
HOST=::
PORT=8000
DEBUG=false
# Comma-separated list of origins allowed to call this API from a browser (CORS)
ALLOWED_ORIGINS=https://luvr-staging.vercel.app,http://localhost:5173

# --- BlueBubbles iMessage Bridge ---
# URL of your BlueBubbles server (running on your Mac)
BLUEBUBBLES_SERVER_URL=http://localhost:1234
# BlueBubbles server password (set in BlueBubbles settings)
BLUEBUBBLES_PASSWORD=your_bluebubbles_password
# Skip messages sent from your own account (set to false when testing alone)
SKIP_OWN_MESSAGES=true

# --- LLM Provider ---
# Which LLM provider to use: "openai", "anthropic", "deepseek", or "opencode"
LLM_PROVIDER=openai
# OpenAI API key (also used for Whisper transcription)
OPENAI_API_KEY=sk-your-openai-api-key
# Anthropic API key (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Deepseek API key (only needed if LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=
# Opencode API key/base URL/provider (only needed if LLM_PROVIDER=opencode)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=http://localhost:54321
OPENCODE_PROVIDER_ID=deepseek
# Model to use (provider-specific)
LLM_MODEL=gpt-4o-mini
# Alternative: LLM_MODEL=claude-3-haiku-20240307

# --- Media Processing ---
# Max attachment size in megabytes (Telegram limit is 20MB for bots)
MAX_ATTACHMENT_SIZE_MB=20
# Alpha eval trace retention window: 7-30 days
EVAL_TRACE_RETENTION_DAYS=14
# Whisper model for voice memo transcription
WHISPER_MODEL=whisper-1

# --- TTS (Text-to-Speech) Voice Replies ---
# Whether to reply with a voice memo when the user sends one
TTS_ENABLED=true
# OpenAI TTS model: "tts-1" (faster, lower quality) or "tts-1-hd" (higher quality, slower)
TTS_MODEL=tts-1
# OpenAI TTS voice preset: alloy, echo, fable, onyx, nova, shimmer
TTS_VOICE=nova

# --- Telegram Bot ---
# Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Mode: "polling" (long-poll for updates) or "webhook" (HTTP push)
TELEGRAM_MODE=polling
# Webhook URL (only needed if TELEGRAM_MODE=webhook)
TELEGRAM_WEBHOOK_URL=
# Comma-separated list of allowed user IDs (empty = allow all)
TELEGRAM_ALLOWED_USER_IDS=

# --- Platform ---
# Which platform to run: "imessage" (default FastAPI server) or "telegram"
PLATFORM=imessage

# --- Rate Limiting ---
MAX_MESSAGES_PER_MINUTE=10
MAX_MESSAGES_PER_HOUR=50

# --- Logging ---
LOG_LEVEL=INFO
# Set to "json" for structured JSON logging (recommended for production)
LOG_FORMAT=console

# --- Alpha Web Auth (src/alpha_auth.py) ---
# Pre-shared invite code required by POST /auth/alpha/exchange
ALPHA_INVITE_CODE=
# HMAC signing secret for alpha session/linking tokens (generate with `openssl rand -hex 32`)
ALPHA_AUTH_SECRET=
# Base URL the Telegram bot uses to build web-linking deep links
ALPHA_WEB_BASE_URL=http://localhost:8000
