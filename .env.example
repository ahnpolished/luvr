# ============================================================
# Luvr - iMessage Dating Advice Chatbot Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Server ---
HOST=::
PORT=8000
DEBUG=false

# --- BlueBubbles iMessage Bridge ---
# URL of your BlueBubbles server (running on your Mac)
BLUEBUBBLES_SERVER_URL=http://localhost:1234
# BlueBubbles server password (set in BlueBubbles settings)
BLUEBUBBLES_PASSWORD=your_bluebubbles_password
# Skip messages sent from your own account (set to false when testing alone)
SKIP_OWN_MESSAGES=true

# --- LLM Provider ---
# Which LLM provider to use: "openai" or "anthropic"
LLM_PROVIDER=openai
# OpenAI API key (also used for Whisper transcription)
OPENAI_API_KEY=sk-your-openai-api-key
# Anthropic API key (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Model to use (provider-specific)
LLM_MODEL=gpt-4o-mini
# Alternative: LLM_MODEL=claude-3-haiku-20240307

# --- Media Processing ---
# Max attachment size in megabytes (Telegram limit is 20MB for bots)
MAX_ATTACHMENT_SIZE_MB=20
# Whisper model for voice memo transcription
WHISPER_MODEL=whisper-1

# --- Telegram Bot ---
# Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Mode: "polling" (long-poll for updates) or "webhook" (HTTP push)
TELEGRAM_MODE=polling
# Webhook URL (only needed if TELEGRAM_MODE=webhook)
TELEGRAM_WEBHOOK_URL=
# Comma-separated list of allowed user IDs (empty = allow all)
TELEGRAM_ALLOWED_USER_IDS=

# --- Platform ---
# Which platform to run: "imessage" (default FastAPI server) or "telegram"
PLATFORM=imessage

# --- Rate Limiting ---
MAX_MESSAGES_PER_MINUTE=10
MAX_MESSAGES_PER_HOUR=50

# --- Logging ---
LOG_LEVEL=INFO
# Set to "json" for structured JSON logging (recommended for production)
LOG_FORMAT=console
