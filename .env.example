# ============================================================
# Luvr - iMessage Dating Advice Chatbot Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- BlueBubbles iMessage Bridge ---
# URL of your BlueBubbles server (running on your Mac)
BLUEBUBBLES_SERVER_URL=http://localhost:1234
# BlueBubbles server password (set in BlueBubbles settings)
BLUEBUBBLES_PASSWORD=your_bluebubbles_password

# --- LLM Provider ---
# Which LLM provider to use: "openai" or "anthropic"
LLM_PROVIDER=openai
# OpenAI API key (also used for Whisper transcription)
OPENAI_API_KEY=sk-your-openai-api-key
# Anthropic API key (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# Model to use (provider-specific)
LLM_MODEL=gpt-4o-mini
# Alternative: LLM_MODEL=claude-3-haiku-20240307

# --- Media Processing ---
# Max attachment size in megabytes
MAX_ATTACHMENT_SIZE_MB=25
# Whisper model for voice memo transcription
WHISPER_MODEL=whisper-1

# --- Rate Limiting ---
MAX_MESSAGES_PER_MINUTE=10
MAX_MESSAGES_PER_HOUR=50

# --- Logging ---
LOG_LEVEL=INFO
# Set to "json" for structured JSON logging (recommended for production)
LOG_FORMAT=console
